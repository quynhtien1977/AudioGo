# Azure API Keys — Template
# KHÔNG commit file này lên git (đã có trong .gitignore)
# Sao chép file này thành .env và điền key thật vào

# ── JWT ──────────────────────────────────────────────────────
# Tạo ngẫu nhiên tối thiểu 32 ký tự
# Gợi ý: https://generate-random.org/string-generator
Jwt__Key=

# ── Azure Blob Storage ───────────────────────────────────────
# Azure Portal → Storage Account → Access Keys → Connection String
Azure__BlobStorage__ConnectionString=

# ── Azure Translator ─────────────────────────────────────────
# Azure Portal → Translator → Keys and Endpoint → KEY 1
Azure__Translator__Key=

# ── Azure Cognitive Speech (TTS) ─────────────────────────────
# Azure Portal → Speech Service → Keys and Endpoint → KEY 1
Azure__Speech__Key=

# ── OpenRouteService ─────────────────────────────────────────
# Đăng ký tài khoản tại https://openrouteservice.org/ -> Dashboard -> Request a Token
ORS_API_KEY=

# ── LLM Service (Cerebras / Qwen) ────────────────────────────
# API Key chung dùng cho các tác vụ AI (VD: Dịch thuật đa ngôn ngữ).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── SePay ─────────────────────────────────────────────────────
# Dashboard: https://my.sepay.vn → Cài đặt → API → Tạo API Token
# 1 key dùng cho cả API access lẫn xác minh webhook (không phân biệt).
Payment__SePay__ApiKey=

# ── MoMo (tích hợp sau) ───────────────────────────────────────
# Dashboard: https://developers.momo.vn → Tạo ứng dụng → Lấy credentials
Payment__MoMo__PartnerCode=
Payment__MoMo__AccessKey=
Payment__MoMo__SecretKey=
# Test: https://test-payment.momo.vn/v2/gateway/api/create
# Prod: https://payment.momo.vn/v2/gateway/api/create
Payment__MoMo__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
