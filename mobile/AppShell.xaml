<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AudioGo_Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AudioGo_Mobile.Views"
    xmlns:controls="clr-namespace:AudioGo_Mobile.Controls"
    Title="AudioGo"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">

    <!-- ── Bottom Tab Bar ── -->
    <TabBar>
        <ShellContent
            x:Name="TabHome"
            Title="Trang chủ"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="Home">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe88a;"
                    Color="{StaticResource Primary}"
                    Size="26" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            x:Name="TabMap"
            Title="Bản đồ"
            ContentTemplate="{DataTemplate views:MapPage}"
            Route="Map">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe55b;"
                    Color="{StaticResource Primary}"
                    Size="26" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            x:Name="TabTours"
            Title="Tours"
            ContentTemplate="{DataTemplate views:TourListPage}"
            Route="Tours">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe56f;"
                    Color="{StaticResource Primary}"
                    Size="26" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            x:Name="TabSearch"
            Title="Khám phá"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="Search">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b6;"
                    Color="{StaticResource Primary}"
                    Size="26" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent
            x:Name="TabSettings"
            Title="Cài đặt"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="Settings">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MaterialIcons"
                    Glyph="&#xe8b8;"
                    Color="{StaticResource Primary}"
                    Size="26" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

    <!-- ── Modal / Push Routes (để trống, routes đăng ký trong code-behind) ── -->
    <Shell.Resources>
        <ResourceDictionary/>
    </Shell.Resources>

</Shell>
