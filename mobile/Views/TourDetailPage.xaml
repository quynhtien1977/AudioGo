<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AudioGo_Mobile.Views.TourDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
             Title="Tour Detail">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header: Mini Map thực (maps:Map) + route Polyline + tap → MapPage ── -->
        <Grid Grid.Row="0" HeightRequest="220">

            <!-- Mini Map: IsScrollEnabled=False, IsZoomEnabled=False, non-interactive -->
            <maps:Map x:Name="MiniMap"
                      IsScrollEnabled="False"
                      IsZoomEnabled="False"
                      IsShowingUser="False"
                      MapType="Street"/>

            <!-- Overlay trong suốt — capture toàn bộ tap trên mini map → MapPage -->
            <Grid BackgroundColor="#00000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMapBannerTapped"/>
                </Grid.GestureRecognizers>

                <!-- Hint bar dưới cùng "Nhấn để xem bản đồ đầy đủ" -->
                <Border BackgroundColor="#CC1A2332"
                        StrokeThickness="0"
                        Padding="0,6"
                        VerticalOptions="End">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="&#xe55b;" FontFamily="MaterialIcons"
                               FontSize="15" TextColor="#3498DB"
                               VerticalOptions="Center"/>
                        <Label Text="{Binding LabelOpenMap}"
                               FontSize="12" TextColor="#AACCEE"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Back button overlay -->
            <Grid Padding="16,52,16,16" VerticalOptions="Start"
                  ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource SemiTransparentLight}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        WidthRequest="40" HeightRequest="40">
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Progress overlay ở bottom map -->
            <Border BackgroundColor="{StaticResource SemiTransparentDark}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="14,10"
                    Margin="16,0,16,36"
                    VerticalOptions="End">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding ProgressText}"
                               TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        <ProgressBar Progress="{Binding ProgressRatio}" HeightRequest="4"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding TotalDuration}"
                           TextColor="#AAAAAA" FontSize="12"
                           VerticalOptions="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Scrollable Content ── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Title -->
                <Label Text="{Binding TourName}"
                       Style="{StaticResource HeadlineLabel}"/>

                <!-- Description -->
                <Label Text="{Binding Description}"
                       Style="{StaticResource BodyLabel}"
                       MaxLines="4"
                       LineBreakMode="TailTruncation"
                       IsVisible="{Binding HasDescription}"/>

                <!-- Action: Nút Khám phá / Dừng + Bắt đầu lại -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="{Binding StartStopLabel}"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnStartTourClicked"/>
                    
                    <Button Grid.Column="1"
                            Text="{Binding ResetLabel}"
                            Clicked="OnResetTourClicked"
                            IsVisible="{Binding IsTourActive}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            Padding="12,0"/>
                </Grid>

                <!-- POI Stops List -->
                <Label Text="{Binding LabelStopList}" Style="{StaticResource SectionTitle}"/>

                <CollectionView ItemsSource="{Binding Stops}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="36,*"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,0">

                                <!-- Timeline column (circle + line) -->
                                <VerticalStackLayout Grid.Column="0"
                                                     HorizontalOptions="Center"
                                                     WidthRequest="36">
                                    <!-- Status circle -->
                                    <Border StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            WidthRequest="28" HeightRequest="28"
                                            HorizontalOptions="Center"
                                            BackgroundColor="{Binding StatusColor}">
                                        <Label Text="{Binding StepNumber}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsVisited}" Value="True">
                                                    <Setter Property="Text" Value="✓" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <!-- Vertical line -->
                                    <BoxView WidthRequest="2"
                                             HeightRequest="48"
                                             HorizontalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200Dark}}"
                                             IsVisible="{Binding IsNotLast}"/>
                                </VerticalStackLayout>

                                <!-- Stop card -->
                                <Border Grid.Column="1"
                                        Style="{StaticResource CardBorder}"
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        BackgroundColor="{Binding CardBgColor}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource SectionTitle}"
                                                   FontSize="14"/>
                                            <Label Text="{Binding Description}"
                                                   Style="{StaticResource CaptionLabel}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"/>
                                            <!-- Walk time đến điểm tiếp theo — ẩn ở stop cuối -->
                                            <HorizontalStackLayout Spacing="4"
                                                                   IsVisible="{Binding IsNotLast}">
                                                <Label Text="&#xe536;"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="13"
                                                       TextColor="#3498DB"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding DurationLabel}"
                                                       FontSize="12"
                                                       TextColor="#3498DB"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <!-- Play/status icon -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeShape="RoundRectangle 18"
                                                StrokeThickness="0"
                                                WidthRequest="36" HeightRequest="36"
                                                VerticalOptions="Center">
                                            <Label Text="&#xe037;"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStopCardTapped"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="20" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Mini Audio Player — dùng lại MainViewModel (singleton) giống MapPage ── -->
        <Border Grid.Row="2"
                x:Name="MiniPlayerBorder"
                Style="{StaticResource MiniPlayerBar}"
                Padding="12,10"
                Margin="12,0,12,12"
                IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        WidthRequest="44" HeightRequest="44">
                    <Grid>
                        <Label Text="&#xe310;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <!-- Logo của POI nếu có — code-behind cập nhật Source + IsVisible -->
                        <Image x:Name="MiniPlayerLogo" Aspect="AspectFill" IsVisible="False"/>

                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="MiniPlayerTitle"
                           Style="{StaticResource SectionTitle}" FontSize="14"
                           LineBreakMode="TailTruncation"/>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="&#xe310;" FontFamily="MaterialIcons" FontSize="11"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                        <Label x:Name="MiniPlayerSub"
                               Style="{StaticResource CaptionLabel}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <!-- Play/Pause -->
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36">
                    <Label x:Name="MiniPlayerPlayIcon"
                           FontFamily="MaterialIcons"
                           FontSize="20" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiniPlayTapped"/>
                    </Border.GestureRecognizers>
                </Border>
                <!-- Close -->
                <Border Grid.Column="3"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray100Dark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36">
                    <Label Text="&#xe5cd;" FontFamily="MaterialIcons" FontSize="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiniPlayerCloseTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
