<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AudioGo.ViewModels"
             xmlns:models="clr-namespace:AudioGo.Mobile.Models"
             x:Class="AudioGo_Mobile.Views.ArticleListPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
             Title="{Binding PageTitle}">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with Back Button -->
        <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="20,52,20,16" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray100Dark}}" StrokeShape="RoundRectangle 20" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,12,0" VerticalOptions="Center">
                <Label Text="&#xe5c4;" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" FontFamily="MaterialIcons" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource HeadlineLabel}" VerticalOptions="Center"/>
        </Grid>

        <!-- Scrollable Vertical List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="0">
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}" HorizontalOptions="Center" Margin="0,30,0,0"/>
                
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="16" HorizontalOptions="Center" Margin="0,60,0,0">
                    <Label Text="&#xe873;" FontFamily="MaterialIcons" TextColor="{StaticResource Gray400}" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Không có bài viết nào" Style="{StaticResource HeadlineLabel}" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding Articles}" IsVisible="{Binding HasArticles}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ArticleViewModel">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="0">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 0" StrokeThickness="0" HeightRequest="140">
                                        <Grid>
                                            <Label Text="{Binding TypeEmoji}" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Image Source="{Binding DisplayImageSource}" Aspect="AspectFill" IsVisible="{Binding HasImage}"/>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Row="1" Padding="14" Spacing="6">
                                        <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" FontSize="15" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Summary}" Style="{StaticResource BodyLabel}" FontSize="13" MaxLines="3" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <Label Grid.Column="0" Text="{Binding TypeDisplayName}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding DateDisplay}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenArticleCommand, Source={x:Reference ThisPage}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView HeightRequest="80" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
