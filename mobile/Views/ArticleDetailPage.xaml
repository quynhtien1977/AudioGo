<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AudioGo.ViewModels"
             x:Class="AudioGo_Mobile.Views.ArticleDetailPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}"
             Title="{Binding Title}">
    
    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!-- ══════════════════════════════════════════════════
                     Hero Image with Premium Gradient Overlay
                ══════════════════════════════════════════════════ -->
                <Grid HeightRequest="240">
                    <!-- Background fallback -->
                    <BoxView Color="{StaticResource DarkSurface}"/>
                    
                    <!-- Fallback Icon / Emoji -->
                    <Label Text="{Binding TypeEmoji}" 
                           FontSize="72" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           IsVisible="{Binding HasImage, Converter={StaticResource IsNotConverter}}"/>

                    <!-- Hero image (AspectFill) -->
                    <Image Source="{Binding HeroImageUrl}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           IsVisible="{Binding HasImage}"/>

                    <!-- Gradient Overlay for Contrast -->
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#88000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.4"/>
                                <GradientStop Color="#00000000" Offset="0.6"/>
                                <GradientStop Color="#CC000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                    </Grid>

                    <!-- Nav Icons (Top) -->
                    <Grid Padding="16,52,16,0"
                          ColumnDefinitions="Auto,*" ColumnSpacing="8"
                          VerticalOptions="Start">
                        <!-- Back Button -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource SemiTransparentDark}"
                                StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                WidthRequest="40" HeightRequest="40">
                            <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Title & Metadata (Bottom of Hero) -->
                    <Grid Padding="16,0,16,16"
                          RowDefinitions="Auto,Auto" RowSpacing="6"
                          VerticalOptions="End">
                        <Label Grid.Row="0"
                               Text="{Binding Title}"
                               TextColor="White"
                               FontSize="20" FontAttributes="Bold"
                               LineBreakMode="WordWrap"/>
                        
                        <HorizontalStackLayout Grid.Row="1" Spacing="8">
                            <!-- Type Badge -->
                            <Border BackgroundColor="{Binding TypeColorHex}"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    Padding="8,3">
                                <Label Text="{Binding TypeDisplayName}" TextColor="White"
                                       FontSize="11" FontAttributes="Bold"/>
                            </Border>
                            
                            <!-- Date Badge -->
                            <Border BackgroundColor="{StaticResource SemiTransparentDark}"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                    Padding="8,3">
                                <Label Text="{Binding DateDisplay}" TextColor="White"
                                       FontSize="11" FontAttributes="Bold"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>

                <VerticalStackLayout Padding="16" Spacing="16">
                    <!-- Loading Indicator for Lazy Load -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                       IsVisible="{Binding IsLoading}" 
                                       Color="{StaticResource Primary}" 
                                       HorizontalOptions="Center" 
                                       Margin="0,20,0,0"/>

                    <!-- Summary Card (Elegant Intro) -->
                    <Border Style="{StaticResource CardBorder}" 
                            Padding="16"
                            BackgroundColor="{StaticResource Surface}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tóm tắt" Style="{StaticResource CaptionLabel}" FontSize="12"/>
                            <Label Text="{Binding Summary}" 
                                   Style="{StaticResource BodyLabel}" 
                                   TextColor="{StaticResource TextSecondary}"
                                   FontAttributes="Italic"
                                   FontSize="14"
                                   LineHeight="1.2"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Main Content Body -->
                    <Border Style="{StaticResource CardBorder}" 
                            Padding="20"
                            BackgroundColor="{StaticResource Surface}"
                            IsVisible="{Binding IsLoading, Converter={StaticResource IsNotConverter}}">
                        <Label Text="{Binding Body}" 
                               Style="{StaticResource BodyLabel}" 
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               LineHeight="1.3"
                               LineBreakMode="WordWrap"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Bottom spacer -->
                <BoxView HeightRequest="40" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
