<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AudioGo.ViewModels"
             xmlns:models="clr-namespace:AudioGo.Mobile.Models"
             x:Class="AudioGo_Mobile.Views.SearchPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header + Search + Filters ── -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                             Padding="20,52,20,12"
                             Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding PageTitle}" Style="{StaticResource HeadlineLabel}"/>
                    <Label Text="{Binding AreaSubtitle}" Style="{StaticResource BodyLabel}"/>
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray100Dark}}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        WidthRequest="40" HeightRequest="40"
                        VerticalOptions="Center">
                    <Label Text="&#xe55b;" FontFamily="MaterialIcons" FontSize="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapViewTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Search pill -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray100Dark}}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Placeholder="{Binding SearchPlaceholder}"
                           PlaceholderColor="{StaticResource Gray400}"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           FontSize="14"
                           ReturnType="Search"
                           Text="{Binding Query}"/>
                    <!-- Clear button -->
                    <Border Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200Dark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Padding="4"
                            IsVisible="{Binding HasResults}">
                        <Label Text="&#xe5cd;" FontFamily="MaterialIcons" FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearchTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- Category filter chips with icons -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8"
                                       BindableLayout.ItemsSource="{Binding CategoryChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChipVm">
                            <Border Padding="12,7"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="1.5">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Gray200}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Label}" FontSize="12" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="TextColor" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.FilterCommand, Source={x:Reference ThisPage}}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- ── Results ── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center"/>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="56" TextColor="{StaticResource Gray300}" HorizontalOptions="Center"/>
                    <!-- ── FIX: Bind title & subtitle để customize theo network state (online vs offline) ── -->
                    <Label Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalOptions="Center"/>
                    <Label Text="{Binding EmptySubtitle}" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Welcome state -->
                <VerticalStackLayout IsVisible="{Binding ShowWelcome}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label Text="&#xe0c8;" FontFamily="MaterialIcons" FontSize="56" TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                    <Label Text="{Binding WelcomeTitle}" Style="{StaticResource HeadlineLabel}" HorizontalOptions="Center"/>
                    <Label Text="{Binding WelcomeSubtitle}" Style="{StaticResource BodyLabel}" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Results: POI section -->
                <Label IsVisible="{Binding HasResults}" Text="{Binding PoiSectionTitle}" Style="{StaticResource SectionTitle}"/>

                <CollectionView ItemsSource="{Binding FilteredPois}" IsVisible="{Binding HasResults}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PoiSearchVm">
                            <Border Style="{StaticResource PoiGridCard}" Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="120">
                                        <Border BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0">
                                            <Label Text="&#xe0c8;" FontFamily="MaterialIcons" FontSize="40" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Image Source="{Binding LogoUrl}" Aspect="AspectFill" HeightRequest="120"/>
                                    </Grid>
                                    <VerticalStackLayout Padding="10,8" Spacing="4">
                                        <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding CategoryLabel}" Style="{StaticResource CaptionLabel}" FontSize="11"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenPoiCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Tours section -->
                <Label IsVisible="{Binding HasTours}" Text="{Binding TourSectionTitle}" Style="{StaticResource SectionTitle}"/>

                <CollectionView ItemsSource="{Binding Tours}" IsVisible="{Binding HasTours}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TourSearchVm">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="0">
                                <Grid ColumnDefinitions="100,*" ColumnSpacing="0">
                                    <Grid Grid.Column="0">
                                        <Border BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0">
                                            <Label Text="&#xe55b;" FontFamily="MaterialIcons" FontSize="36" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill"/>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding PoiCountLabel}" Style="{StaticResource CaptionLabel}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenTourCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Tin tức ── -->
                <VerticalStackLayout IsVisible="{Binding ShowNewsArticlesSection}" Spacing="12" Margin="0,10,0,10">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Text="{Binding NewsTitle}" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding ViewAllLabel}" Style="{StaticResource PrimaryLabel}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllArticlesCommand}" CommandParameter="news"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <CollectionView ItemsSource="{Binding NewsArticles}" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never" SelectionMode="None" HeightRequest="190">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ArticleViewModel">
                                <Border Style="{StaticResource TourCard}" Margin="0,0,12,0" Padding="0">
                                    <Grid RowDefinitions="100,*" RowSpacing="0">
                                        <!-- Thumbnail -->
                                        <Grid Grid.Row="0">
                                            <Border BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0">
                                                <Label Text="{Binding TypeEmoji}" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Image Source="{Binding DisplayImageSource}" Aspect="AspectFill" IsVisible="{Binding HasImage}"/>
                                        </Grid>
                                        <!-- Card Info -->
                                        <VerticalStackLayout Grid.Row="1" Padding="10,8" Spacing="4">
                                            <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding Summary}" Style="{StaticResource CaptionLabel}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"/>
                                                <Label Grid.Column="1" Text="{Binding DateDisplay}" Style="{StaticResource CaptionLabel}" FontSize="11"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.OpenArticleCommand, Source={x:Reference ThisPage}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── Mẹo du lịch ── -->
                <VerticalStackLayout IsVisible="{Binding ShowTipArticlesSection}" Spacing="12" Margin="0,10,0,10">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Text="{Binding TravelTipsTitle}" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding ViewAllLabel}" Style="{StaticResource PrimaryLabel}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllArticlesCommand}" CommandParameter="tip"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <CollectionView ItemsSource="{Binding TipArticles}" ItemsLayout="HorizontalList"
                                    HorizontalScrollBarVisibility="Never" SelectionMode="None" HeightRequest="190">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ArticleViewModel">
                                <Border Style="{StaticResource TourCard}" Margin="0,0,12,0" Padding="0">
                                    <Grid RowDefinitions="100,*" RowSpacing="0">
                                        <!-- Thumbnail -->
                                        <Grid Grid.Row="0">
                                            <Border BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0">
                                                <Label Text="{Binding TypeEmoji}" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Image Source="{Binding DisplayImageSource}" Aspect="AspectFill" IsVisible="{Binding HasImage}"/>
                                        </Grid>
                                        <!-- Card Info -->
                                        <VerticalStackLayout Grid.Row="1" Padding="10,8" Spacing="4">
                                            <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding Summary}" Style="{StaticResource CaptionLabel}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"/>
                                                <Label Grid.Column="1" Text="{Binding DateDisplay}" Style="{StaticResource CaptionLabel}" FontSize="11"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.OpenArticleCommand, Source={x:Reference ThisPage}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <BoxView HeightRequest="16" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
